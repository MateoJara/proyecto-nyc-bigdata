# cluster.env: aquí está toda la configuración del cluster.
# Todos los scripts de infra/ leen este archivo, y tiene que ser igual en todas las VMs.
# Donde diga COMPLETAR se pone lo que muestra 00_diagnostico.sh en cada VM.

# ---- Nodos ------------------------------------------------------------------
# Una posición por VM y en el mismo orden en todas las listas.
# La primera es VM1, que tiene master, worker, Jupyter (driver) y NameNode.
#            VM1 (Mateo)     VM2 (Martín)   VM3 (Wilson)
NODOS_IP=(   "10.43.97.45"   "10.43.97.54"  "10.43.97.50" )  # confirmadas con 00_diagnostico.sh (27-sep-2026)
NODOS_ALIAS=("nyc-vm1"       "nyc-vm2"      "nyc-vm3"   )  # nombres cortos que se agregan a /etc/hosts

# ---- Versiones (iguales en todas las VMs) ----------------------------------------
SPARK_VERSION="4.1.3"         # última versión de mantenimiento de la rama 4.1
HADOOP_VERSION="3.5.0"        # primera rama de Hadoop que soporta oficialmente Java 17
JAVA_MAJOR="17"               # LTS; Spark 4.x exige Java 17 o 21
PYTHON_BIN="python3.11"       # PySpark 4.1 exige Python >= 3.10; Rocky trae 3.9 por defecto

# ---- Usuario y rutas ---------------------------------------------------------
CLUSTER_USER="bigdata"        # usuario de servicio dueño de Spark, HDFS y Jupyter
INSTALL_DIR="/opt"            # /opt/spark, /opt/hadoop
VENV_DIR="/opt/nyc-venv"      # entorno Python idéntico en todas las VMs
DATA_DIR="/data"              # revisar que quede en la partición con más espacio
                              #     (en Rocky suele ser /home; en ese caso usar /home/bigdata/data)
REPO_DIR="/opt/proyecto-nyc-bigdata"

# ---- Almacenamiento compartido -----------------------------------------------
USE_HDFS="true"               # true = HDFS (opción A, la que escogimos). false = copiar los datos a la misma ruta en cada VM (opción B)
HDFS_REPLICATION="2"          # 3 DataNodes; cada bloque en 2 de ellos (tolera perder una VM, ahorra disco)

# ---- Dimensionamiento (el cálculo completo está en docs/arquitectura.md, sección 4) ----
# Las tres VMs tienen 4 cores y 15,7 GB. En cada una se deja 1 core y unos 2 GB para el
# sistema y 1-2 GB para HDFS. VM1 da menos porque además tiene el driver (Jupyter),
# el master y el NameNode.
#                VM1     VM2     VM3
WORKER_CORES=(  "2"     "3"     "3"  )   # 8 cores en total para executors
WORKER_MEMORY=( "5g"    "8g"    "8g" )   # memoria que cada worker reparte entre sus executors
EXECUTOR_CORES="1"            # executors de 1 core: caben exactos en workers de 2 y 3 cores
EXECUTOR_MEMORY="2560m"       # 2,5 GB de heap por executor (+ ~384 MB de overhead fuera del heap)
DRIVER_MEMORY="3g"            # heap del driver (Jupyter en VM1)
SHUFFLE_PARTITIONS="24"       # 3 x 8 cores

# ---- Puertos -----------------------------------------------------------------
SPARK_MASTER_PORT="7077"
SPARK_MASTER_WEBUI_PORT="8080"
SPARK_WORKER_PORT="7078"
SPARK_WORKER_WEBUI_PORT="8081"
SPARK_UI_PORT="4040"
SPARK_DRIVER_PORT="40000"
SPARK_DRIVER_BM_PORT="40001"
SPARK_BM_PORT="40010"         # executors: 40010, 40011, ... (un puerto por executor en la misma VM)
SPARK_PORT_RANGE="40000-40020"
JUPYTER_PORT="8888"           # solo escucha en 127.0.0.1: se accede por túnel SSH
HDFS_NN_PORT="9000"
HDFS_NN_HTTP_PORT="9870"
HDFS_DN_PORTS="9864 9866 9867"
